{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "firebase-hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.10"
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8180
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5101
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4001
    }
  }
}